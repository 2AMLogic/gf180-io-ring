    {
      "name": "i_rail_rel",
      "spice": ".meas tran i_rail_rel FIND i(vsense) AT=4.5u",
      "unit": "A"
    },
    {
      "name": "v_peak_pwr",
      "spice": ".meas tran v_peak_pwr MAX v(dvdd)",
      "unit": "V"
    },
    {
      "name": "v_gate_pk_pwr",
      "spice": ".meas tran v_gate_pk_pwr MAX v(xrail.gio)",
      "unit": "V"
    }
